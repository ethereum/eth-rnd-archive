# discv5 client-compatibility matrix: geth bootnode (record: enr) + one of each EL client
# as a participant. Checks which clients can join the discv5 mesh via an ENR bootnode.
# reth is omitted: with record: enr it crashes at startup (its --bootnodes rejects enr:),
# and it has no CLI way to take a discv5 ENR bootnode — a crash would abort the run.
# Run against the local patched package.
additional_services:
  - bootnode
  - dora

bootnode_params:
  backend: geth
  image: ethpandaops/geth:glamsterdam-devnet-7
  extra_params:
    - --discovery.v4=false
    - --maxpeers=0
  record: enr

participants:
  - el_type: geth              # discv5-only
    el_image: ethpandaops/geth:glamsterdam-devnet-7
    cl_type: lighthouse
    cl_image: ethpandaops/lighthouse:glamsterdam-devnet-7
    el_extra_params:
      - --discovery.v4=false
  - el_type: nethermind        # discv5-only
    el_image: ethpandaops/nethermind:glamsterdam-devnet-7
    cl_type: lighthouse
    cl_image: ethpandaops/lighthouse:glamsterdam-devnet-7
    el_extra_params:
      - --Discovery.DiscoveryVersion
      - V5
  - el_type: ethrex            # discv5-only
    el_image: ethpandaops/ethrex:glamsterdam-devnet-7
    cl_type: lighthouse
    cl_image: ethpandaops/lighthouse:glamsterdam-devnet-7
    el_extra_params:
      - --p2p.discv4=false
  - el_type: erigon            # discv5-only
    el_image: ethpandaops/erigon:glamsterdam-devnet-7
    cl_type: lighthouse
    cl_image: ethpandaops/lighthouse:glamsterdam-devnet-7
    el_extra_params:
      - --discovery.v4=false
  - el_type: besu              # discv5 on, but discv4 can't be disabled
    el_image: ethpandaops/besu:glamsterdam-devnet-7
    cl_type: lighthouse
    cl_image: ethpandaops/lighthouse:glamsterdam-devnet-7
    el_extra_params:
      - --Xv5-discovery-enabled=true
  - el_type: nimbus            # discv5 native, but discv4 also runs
    el_image: ethpandaops/nimbus-eth1:glamsterdam-devnet-7
    cl_type: lighthouse
    cl_image: ethpandaops/lighthouse:glamsterdam-devnet-7
    el_extra_params:
      - --discv5=true

network_params:
  preset: minimal
  gloas_fork_epoch: 1

dora_params:
  image: ethpandaops/dora:master-latest

port_publisher:
  additional_services:
    enabled: true
    public_port_start: 36000

global_log_level: debug
